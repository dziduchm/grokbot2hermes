<mxfile host="app.diagrams.net" type="device">
  <diagram id="g2h-arch" name="grokbot2hermes architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1320" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t_title" value="&lt;b&gt;GrokBot2Hermes architecture: Grok Bot dispatches tasks to a local Hermes Agent gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#57606a;'&gt;g2h 0.1.0. Python 3.9+ standard library only. HTTP contracts per docs/api-contracts.md, verified against Hermes Agent v0.22.7. Includes an optional read-only local dashboard and approval event relay.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#24292f;fontSize=18;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1240" height="56" as="geometry"/></mxCell>
        <mxCell id="l_people" value="People and coordinator" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#82b366;fontColor=#24292f;fontSize=13;fontStyle=1;align=center;rounded=0;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="80" width="440" height="230" as="geometry"/></mxCell>
        <mxCell id="l_g2h" value="g2h: dispatch and track CLI" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=13;fontStyle=1;align=center;rounded=0;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="360" width="430" height="340" as="geometry"/></mxCell>
        <mxCell id="l_trust" value="Trust boundary (auth and egress)" style="swimlane;html=1;startSize=30;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#b85450;fontColor=#24292f;fontSize=13;fontStyle=1;align=center;rounded=0;shadow=0" vertex="1" parent="1"><mxGeometry x="520" y="80" width="430" height="290" as="geometry"/></mxCell>
        <mxCell id="l_gw" value="Local Hermes gateway: Runs API" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=13;fontStyle=1;align=center;rounded=0;shadow=0" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="640" height="600" as="geometry"/></mxCell>
        <mxCell id="l_flow" value="Manual human control flow" style="swimlane;html=1;startSize=30;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#b85450;fontColor=#24292f;fontSize=13;fontStyle=1;align=center;rounded=0;shadow=0" vertex="1" parent="1"><mxGeometry x="990" y="800" width="650" height="392" as="geometry"/></mxCell>
        <mxCell id="l_route" value="Per-profile routing: /p/&amp;lt;profile&amp;gt;/v1/... (one key per profile)" style="swimlane;html=1;startSize=26;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#9673a6;fontColor=#24292f;fontSize=13;fontStyle=1;align=center;rounded=0;shadow=0" vertex="1" parent="1"><mxGeometry x="1015" y="428" width="610" height="236" as="geometry"/></mxCell>
        <mxCell id="l_obs" value="g2h observers (opt-in, local, read-only over g2h's own receipts)" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=13;fontStyle=1;align=center;rounded=0;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="975" width="920" height="300" as="geometry"/></mxCell>
        <mxCell id="b_human" value="&lt;b&gt;Human operator&lt;/b&gt;&lt;br&gt;assigns tasks&lt;br&gt;decides approvals" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#24292f;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_people"><mxGeometry x="20" y="44" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="b_bot" value="&lt;b&gt;Grok Bot&lt;/b&gt;&lt;br&gt;coordinating agent&lt;br&gt;dispatches via g2h" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#24292f;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_people"><mxGeometry x="240" y="44" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="b_poll" value="&lt;b&gt;Adapters (examples)&lt;/b&gt;&lt;br&gt;docs/adapters/grokbot.md&lt;br&gt;grokbot-poll.sh.example" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#24292f;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_people"><mxGeometry x="105" y="134" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="b_launch" value="&lt;b&gt;./g2h: three line sh launcher&lt;/b&gt;&lt;br&gt;g2h.py: one file; Python 3.9+ standard library only" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_g2h"><mxGeometry x="15" y="40" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="b_subs" value="&lt;b&gt;Subcommands&lt;/b&gt;&lt;br&gt;dispatch, status, wait, stop, capabilities&lt;br&gt;resolve approval | clarify | unknown (operator only)&lt;br&gt;dashboard (read-only snapshot), relay (events, opt-in)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_g2h"><mxGeometry x="15" y="110" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="b_flags" value="&lt;b&gt;Options of note&lt;/b&gt;&lt;br&gt;--input, --input-file or --stdin (exactly one)&lt;br&gt;--profile NAME: routes under /p/&amp;lt;profile&amp;gt;/v1/&lt;br&gt;--base-url (default http://127.0.0.1:8642), --json&lt;br&gt;--timeout, --max-retries, --follow (SSE), --no-wait&lt;br&gt;--idempotency-key, --key-file (0600) or --key-stdin" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_g2h"><mxGeometry x="15" y="200" width="400" height="124" as="geometry"/></mxCell>
        <mxCell id="b_keys" value="&lt;b&gt;API key: G2H_API_KEY env, --key-file (0600), --key-stdin&lt;/b&gt;&lt;br&gt;never on argv; scrubbed from every output and receipt" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_trust"><mxGeometry x="15" y="34" width="400" height="64" as="geometry"/></mxCell>
        <mxCell id="b_bearer" value="&lt;b&gt;Authorization: Bearer sent only to the configured base url&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_trust"><mxGeometry x="15" y="106" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="b_egress" value="&lt;b&gt;Redirects disabled: no Authorization on redirects&lt;/b&gt;&lt;br&gt;plain http only to loopback hosts, unless&lt;br&gt;--allow-insecure-http is passed (warns)&lt;br&gt;all output is redacted: key, Bearer, Authorization" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_trust"><mxGeometry x="15" y="154" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="b_caps" value="&lt;b&gt;GET /v1/capabilities: probed by dispatch, wait and resolve unknown (fail soft)&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_gw"><mxGeometry x="15" y="40" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_create" value="&lt;b&gt;POST /v1/runs (Idempotency-Key; Idempotency-Replayed: true on replay)&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_gw"><mxGeometry x="15" y="88" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_status" value="&lt;b&gt;GET /v1/runs/{run_id}: status, output, usage, pending_controls&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_gw"><mxGeometry x="15" y="136" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_events" value="&lt;b&gt;GET /v1/runs/{run_id}/events: SSE; falls back to polling on failures&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_gw"><mxGeometry x="15" y="184" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_stop" value="&lt;b&gt;POST /v1/runs/{run_id}/stop: reports stopping, never instant cancel&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_gw"><mxGeometry x="15" y="232" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_resolve" value="&lt;b&gt;POST /v1/runs/{run_id}/approval | /clarify | /resolve-unknown&lt;/b&gt;&lt;br&gt;manual operator calls; the client never sends them by itself" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_gw"><mxGeometry x="15" y="280" width="610" height="50" as="geometry"/></mxCell>
        <mxCell id="b_coder" value="&lt;b&gt;Hermes profile agent&lt;/b&gt;&lt;br&gt;example: coder&lt;br&gt;runs the dispatched task&lt;br&gt;may park in waiting_for_approval&lt;br&gt;surfaces pending_controls" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#24292f;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_route"><mxGeometry x="25" y="48" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="b_res" value="&lt;b&gt;Hermes profile agent&lt;/b&gt;&lt;br&gt;example: researcher&lt;br&gt;same Runs API surface&lt;br&gt;separate key per profile" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#24292f;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_route"><mxGeometry x="320" y="48" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="b_404" value="&lt;b&gt;401: key not valid for this profile prefix.&lt;/b&gt;&lt;br&gt;404: unknown run id, wrong profile or retention expired." style="dashed=1;dashPattern=4 4;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_route"><mxGeometry x="25" y="188" width="565" height="40" as="geometry"/></mxCell>
        <mxCell id="b_rcpt" value="&lt;b&gt;Crash-safe receipts&lt;/b&gt;&lt;br&gt;one 0600 file per dispatched task&lt;br&gt;0700 dir; atomic tmp file then rename&lt;br&gt;keeps task bytes (sha256) + idem key&lt;br&gt;after a crash: wait --receipt replays&lt;br&gt;stored bytes under the stored key" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="800" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="b_exits" value="&lt;b&gt;Exit codes: the control plane&lt;/b&gt;&lt;br&gt;adapters and operators branch on exit codes, not prose&lt;br&gt;0 completed. 2 usage. 3 credential/config.&lt;br&gt;5 failed. 6 cancelled. 7 interrupted.&lt;br&gt;10 auth. 11 not found. 12 conflict. 13 unavailable.&lt;br&gt;14 timeout: still running at the deadline. 18 transport.&lt;br&gt;16 human control required (waiting_for_approval)." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="1"><mxGeometry x="520" y="800" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="b_f1" value="&lt;b&gt;run parks in waiting_for_approval&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_flow"><mxGeometry x="15" y="40" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_f2" value="&lt;b&gt;g2h exits 16 and surfaces pending_controls verbatim&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_flow"><mxGeometry x="15" y="94" width="610" height="54" as="geometry"/></mxCell>
        <mxCell id="b_f3" value="&lt;b&gt;a HUMAN decides: approve once, deny, or answer the clarify question&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_flow"><mxGeometry x="15" y="162" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_f4" value="&lt;b&gt;operator: g2h resolve approval RUN_ID --request-id ... --generation N --choice once|deny&lt;/b&gt;&lt;br&gt;or: g2h resolve clarify RUN_ID --request-id ... --generation N --answer ..." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_flow"><mxGeometry x="15" y="216" width="610" height="54" as="geometry"/></mxCell>
        <mxCell id="b_f5" value="&lt;b&gt;gateway receives the explicit POST; the run resumes&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_flow"><mxGeometry x="15" y="284" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_f6" value="&lt;b&gt;Nothing auto-approves: the resolve command is typed by an operator;&lt;/b&gt;&lt;br&gt;the client never answers a control by itself." style="dashed=1;dashPattern=4 4;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_flow"><mxGeometry x="15" y="336" width="610" height="40" as="geometry"/></mxCell>
        <mxCell id="b_dash" value="&lt;b&gt;Dashboard: opt-in, read-only&lt;/b&gt;&lt;br&gt;g2h dashboard --serve | --out snapshot.html&lt;br&gt;loopback 127.0.0.1 or localhost, GET only&lt;br&gt;CSP default-src 'none'; style-src 'self'; nosniff&lt;br&gt;no JS, cookies, sessions or forms&lt;br&gt;renders g2h receipts; mutates nothing" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_obs"><mxGeometry x="15" y="44" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="b_relay" value="&lt;b&gt;Relay: opt-in event history&lt;/b&gt;&lt;br&gt;g2h relay --once | --watch&lt;br&gt;events: approval.requested, approval.resolved,&lt;br&gt;run.terminal, gateway.unreachable&lt;br&gt;dedup ledger approvals.json (0600), restart safe&lt;br&gt;one delivery attempt, no auto retries&lt;br&gt;--prune-days 30; --redeliver (human only)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_obs"><mxGeometry x="315" y="44" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="b_notify" value="&lt;b&gt;Notifier: generic, opt-in&lt;/b&gt;&lt;br&gt;--notify-url (webhook POST) or --notify-cmd&lt;br&gt;G2H_NOTIFY_TOKEN: Authorization Bearer&lt;br&gt;one attempt per event; only human retries" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_obs"><mxGeometry x="635" y="44" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="b_ext" value="&lt;b&gt;Real destination (for example an agent bus):&lt;/b&gt;&lt;br&gt;NOT wired in this repo; no URL or token shipped&lt;br&gt;opt-in, requires Marcin's explicit approval" style="dashed=1;dashPattern=4 4;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#24292f;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;spacing=2;shadow=0" vertex="1" parent="l_obs"><mxGeometry x="635" y="134" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" value="tasks" style="edgeStyle=none;html=1;rounded=0;curved=0;strokeColor=#57606a;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=11;fontColor=#57606a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_human" target="b_bot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="dispatches" style="edgeStyle=none;html=1;rounded=0;curved=0;strokeColor=#57606a;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=11;fontColor=#57606a;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;entryX=0.914;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_bot" target="l_g2h"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="g2h wait --receipt ..." style="edgeStyle=none;html=1;rounded=0;curved=0;strokeColor=#57606a;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=11;fontColor=#57606a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5349;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_poll" target="l_g2h"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="requests" style="edgeStyle=none;html=1;rounded=0;curved=0;strokeColor=#57606a;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=11;fontColor=#57606a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3529;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_g2h" target="l_trust"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="480"/><mxPoint x="490" y="225"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="egress" style="edgeStyle=none;html=1;rounded=0;curved=0;strokeColor=#57606a;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=11;fontColor=#57606a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2458;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_trust" target="l_gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="statuses, SSE events, pending_controls" style="edgeStyle=none;html=1;rounded=0;curved=0;strokeColor=#57606a;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=11;fontColor=#57606a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.695;entryX=1;entryY=0.3824;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_gw" target="l_g2h"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="one 0600 receipt per task" style="edgeStyle=none;html=1;rounded=0;curved=0;strokeColor=#57606a;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=11;fontColor=#57606a;labelBackgroundColor=#ffffff;exitX=0.1395;exitY=1;entryX=0.2143;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l_g2h" target="b_rcpt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
